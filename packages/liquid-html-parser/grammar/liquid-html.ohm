Helpers {
  Node = TextNode*
  TextNode = AnyExceptPlus<openControl>
  openControl = end

  empty = /* nothing */
  anyExcept<lit> = (~ lit any)
  anyExceptStar<lit> = (~ lit any)*
  anyExceptPlus<lit> = (~ lit any)+
  AnyExcept<lit> = (~ lit any)
  AnyExceptPlus<lit> = (~ lit any)+
  AnyExceptStar<lit> = (~ lit any)*
  identifierCharacter = alnum | "_" | "-"

  orderedListOf<a, b, sep> =
    | nonemptyOrderedListOf<a, b, sep>
    | emptyListOf<a, sep>
  nonemptyOrderedListOf<a, b, sep> =
    | nonemptyListOf<b, sep>
    | nonemptyOrderedListOfBoth<a, b, sep>
    | nonemptyListOf<a, sep>
  nonemptyOrderedListOfBoth<a, b, sep> =
    nonemptyListOf<a, sep> (sep nonemptyListOf<b, sep>)

  singleQuote = "'" | "‘" | "’"
  doubleQuote = "\"" | "“" | "”"
  controls = "\u{007F}".."\u{009F}"
  noncharacters = "\u{FDD0}".."\u{FDEF}"
  newline = "\r"? "\n"
}

Liquid <: Helpers {
  Node := (liquidNode | TextNode)*
  openControl := "{{" | "{%"
  endOfTagName = &("-%}" | "-}}" | "%}" | "}}")
  endOfVarName = ~identifierCharacter
  endOfIdentifier = endOfTagName | endOfVarName

  // PERF: single-character positive lookahead guard.
  //
  // Every alternative below begins with "{{" or "{%", so input that does not
  // start with "{" cannot match. Without the guard, Ohm enters the alternation at
  // every candidate position and fans out into ~35 `liquidTagRule<name, markup>`
  // plus ~14 `liquidTagOpenRule<name, markup>` applications before failing. Those
  // are PARAMETERIZED applications, and `Apply.prototype.substituteParams` only
  // returns `this` when `args.length === 0` — so each one allocates a fresh
  // `Apply` and rebuilds its memo-key string on every evaluation, and therefore
  // never hits the memo table. That is why a parse profile shows `toMemoKey` and
  // `Apply.toString` high in self time with a large share of CPU in GC.
  //
  // It matters because `liquidNode` is reached from three hot places: `Node`'s
  // iteration, `Attr`, and `attr{Single,Double}QuotedValue` — i.e. once per text
  // run, once per attribute slot, and once per attribute value segment.
  //
  // Written with the `~(~x)` double-negation idiom already used by
  // `argumentSeparatorOptionalComma` so it contributes arity 0 and the CST shape is
  // unchanged — `LiquidMappings.liquidNode: 0` still indexes the alternation.
  // Verified CST-identical (ctorName + source intervals + node count, sha1) over
  // 1392 real files, with identical parse outcomes and identical lint offenses.
  liquidNode =
    ~(~"{") (liquidDoc
      | liquidBlockComment
      | liquidRawTag
      | liquidDrop
      | liquidTagClose
      | liquidTagOpen
      | liquidTag
      | liquidInlineComment)

  liquidTagStrict =
    | liquidTagAssign
    | liquidTagHashAssign
    | liquidTagBreak
    | liquidTagContinue
    | liquidTagCycle
    | liquidTagDecrement
    | liquidTagEcho
    | liquidTagElse
    | liquidTagElsif
    | liquidTagInclude
    | liquidTagIncrement
    | liquidTagLiquid
    | liquidTagRender
    | liquidTagFunction
    | liquidTagGraphQL
    | liquidTagWhen
    // platformos tags
    | liquidTagBackground
    | liquidTagCatch
    | liquidTagContext
    | liquidTagExport
    | liquidTagIncludeForm
    | liquidTagLog
    | liquidTagPrint
    | liquidTagRedirectTo
    | liquidTagResponseHeaders
    | liquidTagResponseStatus
    | liquidTagReturn
    | liquidTagRollback
    | liquidTagSession
    | liquidTagSignIn
    | liquidTagSpamProtection
    | liquidTagThemeRenderRc
    | liquidTagYield

  liquidTag =
    | liquidTagStrict
    | liquidTagBaseCase

  liquidTagOpenStrict =
    | liquidTagOpenCase
    | liquidTagOpenCapture
    | liquidTagOpenForm
    | liquidTagOpenFor
    | liquidTagOpenGraphQL
    | liquidTagOpenTablerow
    | liquidTagOpenIf
    | liquidTagOpenUnless
    // platformos block tags
    | liquidTagOpenBackground
    | liquidTagOpenCache
    | liquidTagOpenContentFor
    | liquidTagOpenParseJson
    | liquidTagOpenTransaction
    | liquidTagOpenTry

  liquidTagOpenGraphQL = liquidTagOpenRule<"graphql", liquidTagGraphQLInlineMarkup>
  // Use negative lookahead to exclude file-based syntax (with "=")
  liquidTagGraphQLInlineMarkup = variableSegment ~(space* "=") graphqlRenderArguments liquidFilter<delimTag>* space*

  liquidTagOpen =
    | liquidTagOpenStrict
    | liquidTagOpenBaseCase

  liquidTagClose = "{%" "-"? space* "end" blockName space* tagMarkup "-"? "%}"

  // These two are the same but transformed differently
  liquidTagRule<name, markup> =
    "{%" "-"? space* (name endOfIdentifier) space* markup "-"? "%}"
  liquidTagOpenRule<name, markup> =
    "{%" "-"? space* (name endOfIdentifier) space* markup "-"? "%}"

  liquidTagBaseCase = liquidTagRule<liquidTagName, tagMarkup>

  liquidTagEcho = liquidTagRule<"echo", liquidTagEchoMarkup>
  liquidTagEchoMarkup = liquidVariable<delimTag>

  liquidTagAssign = liquidTagRule<"assign", liquidTagAssignMarkup>
  liquidTagAssignMarkup = assignTarget<delimTag> space* writeOperator space* liquidAssignValue<delimTag>

  // Assign-specific sub-rules
  assignTarget<delim> = variableSegment lookup<delim>*
  // Only one operator per write: either `=` (regular assignment) or `<<` (push).
  // The two forms are mutually exclusive — `{% assign a << "item" %}` pushes onto `a`,
  // and `{% assign a = value %}` assigns to `a`. A compound shape like
  // `{% assign a = b << c %}` is INVALID per the platformOS runtime.
  //
  // Shared with `function`, whose append form collects a partial's return value into an array:
  // `{% function items << 'path/to/partial' %}`. NOT shared with `hash_assign`, which was
  // measured to reject it — "Syntax Error in 'hash_assign' - Valid syntax:
  // hash_assign hash[key] = value" — so that tag keeps a bare "=".
  writeOperator = "<<" | "="

  // The RHS of an assign: a regular value (expression + optional filters).
  liquidAssignValue<delim> = liquidAssignVariable<delim>

  // Assign variable: like liquidVariable but expression allows JSON literals
  liquidAssignVariable<delim> = liquidAssignExpression<delim> liquidFilter<delim>* space* &delim
  liquidAssignExpression<delim> =
    | liquidJsonHashLiteral<delim>
    | liquidJsonArrayLiteral<delim>
    | liquidComplexExpression<delim>

  // JSON literal rules (assign, return, and named argument values; recursive)
  liquidJsonHashLiteral<delim> =
    "{" space* listOf<liquidJsonKeyValue<delim>, liquidJsonSep> space* "}"
  liquidJsonKeyValue<delim> =
    liquidJsonKey<delim> space* ":" space* liquidJsonValue<delim>
  liquidJsonKey<delim> = liquidJsonString<delim> | liquidString<delim> | liquidJsonBareKey
  liquidJsonBareKey = variableSegment
  liquidJsonArrayLiteral<delim> =
    "[" space* listOf<liquidJsonValue<delim>, liquidJsonSep> space* "]"
  liquidJsonValue<delim> =
    | liquidJsonHashLiteral<delim>
    | liquidJsonArrayLiteral<delim>
    | liquidJsonItemVariable<delim>
    | liquidJsonString<delim>
    | liquidExpression<delim>
  // The runtime hands hash/array literals to Ruby's JSON parser, so backslash escape pairs
  // ARE meaningful in their keys and unfiltered string values: `{ "q": "he said \"hi\"" }`
  // is one string. JSON has no single-quoted strings — and the runtime rejects them inside
  // a literal — so this is double-quote only. Filtered values are deliberately excluded:
  // `{ "a": "x\"y" | upcase }` is a runtime syntax error, because the runtime strips filters
  // before JSON-parsing, so it must stay a parse error here too.
  liquidJsonString<delim> = "\"" liquidJsonStringBody<delim> "\""
  liquidJsonStringBody<delim> = (liquidStringEscape | liquidJsonStringChar<delim>)*
  liquidJsonStringChar<delim> = ~("\"" | "\\" | delim) any
  liquidStringEscape = "\\" any
  // Like liquidVariable but without &delim lookahead, so it works inside JSON structures.
  // Requires at least one filter (liquidJsonFilter+) so plain expressions fall through to liquidExpression.
  // Uses liquidJsonFilter (no trailing comma) instead of liquidFilter to avoid consuming the
  // JSON entry separator comma (e.g. the "," in { "a": x | filter: arg, "b": y }).
  liquidJsonItemVariable<delim> = liquidComplexExpression<delim> liquidJsonFilter<delim>+ space*
  // Like liquidFilter but without the trailing (space* ",")? so commas between JSON entries
  // are not consumed as trailing filter argument commas.
  liquidJsonFilter<delim> = space* "|" space* identifier (space* ":" space* arguments<delim>)?
  liquidJsonSep = space* "," space*

  liquidTagHashAssign = liquidTagRule<"hash_assign", liquidTagHashAssignMarkup>
  liquidTagHashAssignMarkup = liquidVariableLookup<delimTag> space* "=" space* liquidVariable<delimTag>

  liquidTagCycle = liquidTagRule<"cycle", liquidTagCycleMarkup>
  liquidTagCycleMarkup = (liquidExpression<delimTag> ":")? space* nonemptyListOf<liquidFilteredExpression<delimTag>, argumentSeparator> space*

  liquidTagIncrement = liquidTagRule<"increment", variableSegmentAsLookupMarkup>
  liquidTagDecrement = liquidTagRule<"decrement", variableSegmentAsLookupMarkup>
  liquidTagOpenCapture = liquidTagOpenRule<"capture", variableSegmentAsLookupMarkup>
  variableSegmentAsLookupMarkup = variableSegmentAsLookup space*

  // We'll black hole the statement and switch parser in the cst builder
  // We do this because it's technically the same grammar (with minor redefinitions)
  // and it would be a huge chore and maintenance hell to rewrite all the rules with
  // hspace = " " | "\t"
  //
  // The alternative is that this grammar parses the {% liquid tagMarkup %} as its own string,
  // and then we switch to the LiquidStatement grammar that
  // redefines liquidTagOpenRule, liquidTagRule, and space.
  liquidTagLiquid = liquidTagRule<"liquid", liquidTagLiquidMarkup>
  liquidTagLiquidMarkup = tagMarkup

  liquidTagOpenContentFor = liquidTagOpenRule<"content_for", liquidTagContentForMarkup>
  liquidTagContentForMarkup = contentForType space*
  contentForType = liquidString<delimTag>

  liquidTagInclude = liquidTagRule<"include", liquidTagIncludeMarkup>
  liquidTagIncludeMarkup =
    partialExpression renderVariableExpression? renderAliasExpression? renderArguments

  liquidTagRender = liquidTagRule<"render", liquidTagRenderMarkup>
  liquidTagRenderMarkup =
    liquidString<delimTag> renderVariableExpression? renderAliasExpression? renderArguments

  liquidTagFunction = liquidTagRule<"function", liquidTagFunctionMarkup>
  // `writeOperator`, not a bare "=", because the append form is real: `{% function items << 'p' %}`
  // collects the partial's return value onto an array. Measured on a live instance — it reaches
  // partial resolution ("can't find partial") where a genuine syntax error reports
  // "Invalid syntax for function tag" — so the runtime parses it and this grammar has to as well.
  // An lvalue target (`response["data"] << 'p'`) needs nothing extra: `liquidVariableLookup`
  // already carries the lookups.
  liquidTagFunctionMarkup = liquidVariableLookup<delimTag> space* writeOperator space* partialExpression resultFilterRenderArguments liquidFilter<delimTag>* space*

  liquidTagGraphQL = liquidTagRule<"graphql", liquidTagGraphQLMarkup>
  liquidTagGraphQLMarkup = variableSegment space* "=" space* partialExpression graphqlRenderArguments liquidFilter<delimTag>* space*

  // platformos simple tags
  liquidTagBackground = liquidTagRule<"background", liquidTagBackgroundMarkup>
  // Same shape as `function` above — see `resultFilterRenderArguments`.
  liquidTagBackgroundMarkup = variableSegment space* "=" space* partialExpression resultFilterRenderArguments liquidFilter<delimTag>* space*

  liquidTagOpenBackground = liquidTagOpenRule<"background", liquidTagBackgroundInlineMarkup>
  // Block form: only named arguments, no result variable (matches Ruby inline syntax)
  // Use negative lookahead to exclude file-based syntax (with "=")
  liquidTagBackgroundInlineMarkup = ~(variableSegment space* "=") argumentSeparatorOptionalComma tagArguments (space* ",")? space*

  liquidTagOpenCache = liquidTagOpenRule<"cache", liquidTagCacheMarkup>
  liquidTagCacheMarkup = liquidFilteredExpression<delimTag> renderArguments

  liquidTagOpenParseJson = liquidTagOpenRule<"parse_json", variableSegmentAsLookupMarkup>

  liquidTagOpenTransaction = liquidTagOpenRule<"transaction", liquidTagOpenTransactionMarkup>
  liquidTagOpenTransactionMarkup = tagArguments (space* ",")? space*

  liquidTagOpenTry = liquidTagOpenRule<"try", empty>

  liquidTagCatch = liquidTagRule<"catch", liquidTagCatchMarkup>
  liquidTagCatchMarkup = variableSegmentAsLookup? space*

  liquidTagLog = liquidTagRule<"log", liquidTagLogMarkup>
  liquidTagLogMarkup = liquidFilteredExpression<delimTag> liquidTagLogArguments
  liquidTagLogArguments = (argumentSeparatorOptionalComma logArguments) (space* ",")? space*
  logArguments = listOf<logArgument<delimTag>, argumentSeparatorOptionalComma>
  logArgument<delim> = tagNamedArgument<delim> | tagPositionalArgument<delim>

  liquidTagPrint = liquidTagRule<"print", liquidTagEchoMarkup>

  liquidTagReturn = liquidTagRule<"return", liquidTagReturnMarkup>
  liquidTagReturnMarkup = liquidReturnVariable<delimTag>? space*
  liquidReturnVariable<delim> = liquidReturnExpression<delim> liquidFilter<delim>* space* &delim
  liquidReturnExpression<delim> =
    | liquidJsonHashLiteral<delim>
    | liquidJsonArrayLiteral<delim>
    | liquidComplexExpression<delim>

  liquidTagYield = liquidTagRule<"yield", liquidTagYieldMarkup>
  liquidTagYieldMarkup = liquidFilteredExpression<delimTag> space*

  liquidTagSession = liquidTagRule<"session", liquidTagSessionMarkup>
  liquidTagSessionMarkup = variableSegment space* "=" space* liquidVariable<delimTag> space*

  liquidTagExport = liquidTagRule<"export", liquidTagExportMarkup>
  liquidTagExportMarkup = nonemptyListOf<exportVariable, argumentSeparator> liquidTagExportNamespace? space*
  liquidTagExportNamespace = argumentSeparatorOptionalComma tagNamedArgument<delimTag>
  // Variable lookup that is NOT followed by ":" (to distinguish from named arguments)
  exportVariable = variableSegmentAsLookup ~(space* ":")

  liquidTagContext = liquidTagRule<"context", liquidTagContextMarkup>
  liquidTagContextMarkup = tagArguments (space* ",")? space*

  liquidTagSignIn = liquidTagRule<"sign_in", liquidTagSignInMarkup>
  liquidTagSignInMarkup = tagArguments (space* ",")? space*

  liquidTagRedirectTo = liquidTagRule<"redirect_to", liquidTagRedirectToMarkup>
  liquidTagRedirectToMarkup = liquidFilteredExpression<delimTag> renderArguments

  liquidTagIncludeForm = liquidTagRule<"include_form", liquidTagIncludeFormMarkup>
  liquidTagIncludeFormMarkup = partialExpression renderArguments

  liquidTagSpamProtection = liquidTagRule<"spam_protection", liquidTagSpamProtectionMarkup>
  liquidTagSpamProtectionMarkup = liquidFilteredExpression<delimTag> renderArguments

  liquidTagThemeRenderRc = liquidTagRule<"theme_render_rc", liquidTagRenderMarkup>

  liquidTagResponseStatus = liquidTagRule<"response_status", liquidTagResponseStatusMarkup>
  liquidTagResponseStatusMarkup = responseStatusValue space*
  // A third operand shape, distinct from `liquidFilteredExpression` and from the tag argument
  // rules: the operand stays restricted to a number or a lookup, and only the filter suffix is
  // added. Reusing `liquidFilteredExpression` here would have widened the operand to any
  // expression, which is a change to what the tag ACCEPTS rather than a false-block fix.
  responseStatusValue =
    | responseStatusValueWithFilters
    | responseStatusOperand
  responseStatusValueWithFilters = responseStatusOperand liquidFilter<delimTag>+
  responseStatusOperand = liquidNumber | liquidVariableLookup<delimTag>

  liquidTagResponseHeaders = liquidTagRule<"response_headers", liquidTagResponseHeadersMarkup>
  liquidTagResponseHeadersMarkup = liquidFilteredExpression<delimTag> space*

  liquidTagRollback = liquidTagRule<"rollback", empty>

  renderArguments = (argumentSeparatorOptionalComma tagArguments) (space* ",")? space*
  // Filterless arguments, so that a filter written after the last argument lands on the MARKUP
  // node rather than being absorbed into the argument — a filtered argument value would win the
  // PEG ordered choice and silently steal it.
  //
  // This is a PARSING choice, not a claim about the runtime. Measured, `function` and
  // `background` do NOT filter their result: the trailing filter binds to the last argument and
  // is discarded unless that argument is a JSON literal. Parking it on the markup keeps the
  // author's text round-trippable by the printer and gives `FilterWithoutEffect` one node to
  // report — do not read `FunctionMarkup.filters` as "a result filter".
  // Used by `function` and `background`; graphql has its own `graphqlRenderArguments` path.
  resultFilterRenderArguments = (argumentSeparatorOptionalComma filterlessTagArguments) (space* ",")? space*
  completionModeRenderArguments = (argumentSeparatorOptionalComma tagArguments) (space* ",")? space* (argumentSeparator? liquidVariableLookup<delimTag> space*)?
  partialExpression = liquidString<delimTag> | liquidVariableLookup<delimTag>
  renderVariableExpression = space+ ("for" | "with") space+ liquidFilteredExpression<delimTag>
  renderAliasExpression = space+ "as" space+ variableSegment

  // Exclude graphql and background from base case since they have special handling
  liquidTagOpenBaseCase = liquidTagOpenRule<blockNameNotSpecial, tagMarkup>
  blockNameNotSpecial =
    ( "form"
    | "capture"
    | "case"
    | "for"
    | "ifchanged"
    | "if"
    | "unless"
    | "tablerow"
    // platformos blocks that need base case handling
    | "cache"
    | "parse_json"
    | "transaction"
    // `try_rc` BEFORE `try`: an ordered choice would match `try` and then choke on `_rc`.
    | "try_rc"
    | "try"
    ) endOfIdentifier

  liquidTagOpenForm = liquidTagOpenRule<"form", liquidTagOpenFormMarkup>
  // Matches the platformOS runtime (FormForTag): an optional positional model name first
  // ({% form form, method: 'delete' %}), then key: value attributes. The runtime scans
  // `[\w-]+: value` pairs out of the markup, so keys may contain hyphens (html-class:,
  // html-data-user-id:), commas between attributes are optional, and bare {% form %} is valid.
  liquidTagOpenFormMarkup =
    orderedListOf<tagPositionalArgument<delimTag>, tagNamedArgument<delimTag>, argumentSeparatorOptionalComma> (space* ",")? space*

  liquidTagOpenFor = liquidTagOpenRule<"for", liquidTagOpenForMarkup>

  liquidTagOpenForMarkup =
    variableSegment space* "in" space* liquidExpression<delimTag>
    (space* "reversed")? argumentSeparatorOptionalComma
    tagArguments (space* ",")? space*

  // It's the same, the difference is support for different named arguments<delim>
  liquidTagOpenTablerow = liquidTagOpenRule<"tablerow", liquidTagOpenForMarkup>

  liquidTagOpenCase = liquidTagOpenRule<"case", liquidTagOpenCaseMarkup>
  liquidTagOpenCaseMarkup = liquidFilteredExpression<delimTag> space*

  liquidTagWhen = liquidTagRule<"when", liquidTagWhenMarkup>
  liquidTagWhenMarkup = nonemptyListOf<liquidFilteredExpression<delimTag>, whenMarkupSep> space*
  whenMarkupSep = space* ("," | "or" ~identifier) space*

  liquidTagOpenIf = liquidTagOpenRule<"if", liquidTagOpenConditionalMarkup>
  liquidTagOpenUnless = liquidTagOpenRule<"unless", liquidTagOpenConditionalMarkup>
  liquidTagElsif = liquidTagRule<"elsif", liquidTagOpenConditionalMarkup>

  liquidTagBreak = liquidTagRule<"break", empty>
  liquidTagContinue = liquidTagRule<"continue", empty>
  liquidTagElse = liquidTagRule<"else", empty>

  liquidTagOpenConditionalMarkup = nonemptyListOf<condition<delimTag>, conditionSeparator> space*
  conditionSeparator = &logicalOperator
  condition<delim> = logicalOperator? space* (comparison<delim> | liquidExpression<delim>) space*
  logicalOperator = ("and" | "or") ~identifier
  comparison<delim> = liquidExpression<delim> space* comparator space* liquidExpression<delim>
  comparator =
    ( "=="
    | "!="
    | ">="
    | "<="
    | ">"
    | "<" ~"<")
    | ("contains" ~identifier)

  liquidDrop = "{{" "-"? space* liquidDropCases "-"? "}}"
  liquidDropCases = liquidVariable<delimVO> | liquidDropBaseCase
  liquidDropBaseCase = anyExceptStar<delimVO>
  liquidInlineComment = "{%" "-"? space* "#" space? tagMarkup "-"? "%}"

  liquidRawTag =
    | liquidRawTagImpl<"raw">
  liquidRawTagImpl<name> =
    "{%" "-"? space* (name endOfIdentifier) space* tagMarkup "-"? "%}"
    anyExceptStar<liquidRawTagClose<name>>
    "{%" "-"? space* "end" (name endOfIdentifier) space* "-"? "%}"
  liquidRawTagClose<name> =
    "{%" "-"? space* "end" (name endOfIdentifier) space* "-"? "%}"

  liquidBlockComment =
    commentBlockStart
      (liquidBlockComment | anyExceptPlus<(commentBlockStart | commentBlockEnd)>)*
    commentBlockEnd
  commentBlockStart = "{%" "-"? space* ("comment"    endOfIdentifier) space* tagMarkup "-"? "%}"
  commentBlockEnd   = "{%" "-"? space* ("endcomment" endOfIdentifier) space* tagMarkup "-"? "%}"

  liquidDoc =
    liquidDocStart
      liquidDocBody
    liquidDocEnd

  liquidDocStart = "{%" "-"? space* ("doc" endOfIdentifier) space* tagMarkup "-"? "%}"
  liquidDocEnd = "{%" "-"? space* ("enddoc" endOfIdentifier) space* tagMarkup "-"? "%}"
  liquidDocBody = anyExceptStar<(liquidDocStart | liquidDocEnd)>

  // In order for the grammar to "fallback" to the base case, this
  // rule must pass if and only if we support what we parse. This
  // implies that—since we don't support filters yet—we have a
  // positive lookahead on "-}}" or "}}" in the rule. We do this
  // because we'd otherwise positively match the following string
  // instead of falling back to the other rule:
  // {{ 'string' | some_filter }}
  // An ARRAY LITERAL is a legal head here — in a `{{ }}`, an `{% echo %}`/`{% print %}`, or a
  // `{% hash_assign %}` value — and it must be tried BEFORE `liquidComplexExpression`, because
  // `liquidVariableLookup` has an `empty lookup+` alternative that matches `["x"]` as a subscript
  // on no base. That is Shopify's dynamic lookup, where `{{ [type] }}` reads the variable NAMED BY
  // the value of `type`. platformOS has no such form. Measured on a live instance
  // (`pos-cli exec liquid`), with the lookup target assigned so the two readings differ:
  //
  //   {% assign type = "shirt" %}{% assign shirt = "SHIRTVAL" %}{{ [type] }}  =>  ["shirt"]
  //   {% assign product = "PV" %}{{ ["product"] }}                            =>  ["product"]
  //   {% assign x = "VARX" %}{{ ["x"] | size }}                               =>  1
  //
  // Every one is the array literal, rendered as JSON — never the lookup, whose values
  // (`SHIRTVAL`, `PV`, and `4` for the length of `"VARX"`) do not appear. `h[type]` — a subscript
  // on a NAMED base — does not reach this rule and still resolves.
  //
  // THE TAIL IS DUPLICATED PER ALTERNATIVE ON PURPOSE. Hoisting the head into its own
  // `arrayLiteral | complexExpression` rule is the obvious refactor and it is WRONG: ordered
  // choice COMMITS once an alternative matches, so for `{{ ["x"].y }}` the array would win, the
  // trailing `&delim` would then fail on `.y`, and PEG would not re-enter the committed choice to
  // try the lookup. The whole rule fails and the drop degrades to raw-string markup — measured,
  // that is exactly what the hoisted form produced — which the syntax-error check reports as
  // "Syntax is not supported", the way it still reports `{{ [1,2].y }}`. That would be a FALSE
  // POSITIVE: `{{ ["x"].y }}` and `{{ ["x"]["y"] }}` both render `["x"]` on the platform. With the
  // tail inside each alternative the `&delim` failure backtracks within THIS alternation and the
  // lookup form is still reached, so those shapes keep the exact CST they have always had.
  //
  // Keeping them as a lookup does diverge from the runtime, which discards the `.y` and prints
  // `["x"]`. That divergence is deliberate: it is the pre-existing behaviour, it reports nothing,
  // and a node carrying only the array would make the printer DELETE `.y` from the author's file.
  //
  // Ohm requires every alternative of an ordered choice to have the same arity, and both here are
  // 4 — so the positional CST mapping (`expression: 0`, `filters: 1`, `tokens[length - 2]`) is
  // unchanged and needs no new entry.
  //
  // Only the ARRAY literal belongs in this position. A hash literal is a genuine platformOS
  // syntax error in a drop, and not because it is a hash: the runtime's variable scanner stops at
  // the first `}`, so `{{ "a}b" }}` fails identically ("Variable '{{ \"a}' was not properly
  // terminated"). That lexical quirk is orthogonal and is modelled nowhere in this grammar.
  //
  // The array head produces the same LiquidVariable shape `{% assign %}` and `{% return %}`
  // already build via `liquidAssignExpression`/`liquidReturnExpression`, so stage 2 and the
  // prettier printer need no new node — see `LiquidVariable.expression` in stage-2-ast.
  liquidVariable<delim> =
    | liquidJsonArrayLiteral<delim> liquidFilter<delim>* space* &delim
    | liquidComplexExpression<delim> liquidFilter<delim>* space* &delim

  // Expression plus optional filters, WITHOUT liquidVariable's trailing `space* &delim`
  // lookahead — so it can be used where more markup follows (arguments, list separators).
  //
  // WHY IT EXISTS. Several tag operands bound `liquidExpression`, which has no filters, so
  // `{% cache 'k' | append: '1' %}` failed the strict markup rule. The parser is tolerant,
  // so the tag fell back to raw-string markup and `InvalidTagSyntax` reported it — a FALSE
  // BLOCK on code `pos-cli deploy --dry-run` accepts. Measured with paired dry-runs (filter
  // present, then absent) for every operand below.
  //
  // It produces a LiquidVariable node, the same shape `{{ }}` and `{% assign %}` already
  // use. That keeps every parent rule's arity unchanged AND means the prettier printer
  // already knows how to print it — printing `expression` plus `filters`. A rule that
  // parsed filters the printer did not model would silently DELETE them on format.
  liquidFilteredExpression<delim> =
    | liquidExpressionWithFilters<delim>
    | liquidExpression<delim>

  // `liquidFilter+`, one or more — so an operand with NO filter falls through to the bare
  // `liquidExpression` above and keeps exactly the CST and AST shape it has always had.
  // Matching zero filters here instead would wrap every one of these operands in a
  // LiquidVariable purely because a different tag might carry filters, changing the shape
  // for every existing file, consumer and fixture to no purpose — measured, it broke 22
  // stage-2 and 12 stage-1 assertions that were describing correct behaviour.
  //
  // Same idiom, and same reason, as `liquidJsonItemVariable` above.
  liquidExpressionWithFilters<delim> = liquidExpression<delim> liquidFilter<delim>+

  liquidExpression<delim> =
    | liquidString<delim>
    | liquidNumber
    | liquidLiteral
    | liquidRange<delim>
    | liquidVariableLookup<delim>

  liquidComplexExpression<delim> =
    | liquidBooleanExpression<delim>
    | liquidExpression<delim>

  liquidBooleanExpression<delim> = booleanExpressionCondition<delim> listOf<booleanExpressionSubsequentCondition<delim>, conditionSeparator>

  // This might over-capture things since the conditions below can contain any `liquidExpression`s.
  // We will need to clean this up in CST. If we restrict the conditions to only contain comparisons and
  // variable lookups, we can't support "truthy" expressions like `{{ some_var and 'this' }}`
  booleanExpressionSubsequentCondition<delim> = space* logicalOperator space* (comparison<delim> | liquidExpression<delim>) space*
  booleanExpressionCondition<delim> = comparison<delim> | liquidExpression<delim>

  liquidString<delim> = liquidSingleQuotedString<delim> | liquidDoubleQuotedString<delim>
  // Plain Liquid strings are NOT escape-aware: the runtime's lexer ends the string at the
  // first matching quote, backslash or no backslash. `{% assign x = 'can\'t' %}` assigns
  // `can\` (and the trailing `t'` is dropped), `{% assign x = "a\"b" %}` assigns `a\`, and
  // `{% assign x = '\' %}` is a well-formed one-backslash string — a common building block
  // for regex escaping. Only string values inside JSON hash/array literals honour escape
  // pairs, because only those reach Ruby's JSON parser — see liquidJsonString.
  liquidSingleQuotedString<delim> = "'" liquidSingleQuotedStringBody<delim> "'"
  liquidDoubleQuotedString<delim> = "\"" liquidDoubleQuotedStringBody<delim> "\""
  liquidSingleQuotedStringBody<delim> = liquidSingleQuotedStringChar<delim>*
  liquidDoubleQuotedStringBody<delim> = liquidDoubleQuotedStringChar<delim>*
  liquidSingleQuotedStringChar<delim> = ~("'" | delim) any
  liquidDoubleQuotedStringChar<delim> = ~("\"" | delim) any

  liquidNumber = liquidFloat | liquidInteger
  liquidInteger = "-"? digit+
  liquidFloat = "-"? digit+ "." digit+

  liquidLiteral =
    ( "true"
    | "false"
    | "blank"
    | "empty"
    | "nil"
    | "null"
    ) endOfIdentifier

  liquidRange<delim> =
    "(" space* liquidExpression<delim> space* ".." space* liquidExpression<delim> space* ")"

  liquidVariableLookup<delim> =
    | variableSegment lookup<delim>*
    | empty lookup<delim>+
  lookup<delim> =
    | indexLookup<delim>
    | dotLookup
  indexLookup<delim> = space* "[" space* liquidExpression<delim> space* "]"
  dotLookup = space* "." space* dotLookupName
  dotLookupName = (alnum | "_") (~endOfTagName identifierCharacter)* "?"?

  liquidFilter<delim> = space* "|" space* identifier (space* ":" space* arguments<delim> (space* ",")?)?

  arguments<delim> = nonemptyOrderedListOf<positionalArgument<delim>, namedArgument<delim>, argumentSeparator>
  argumentSeparator = space* "," space*
  argumentSeparatorOptionalComma = space* ","? space*
  // liquidExpressionOrJsonLiteral: used in argument value positions where JSON hash/array
  // literals are accepted (named args, filter positional args). It stays a SEPARATE rule rather
  // than widening liquidExpression, because liquidExpression is also the operand of indexLookup,
  // liquidRange and comparison — `a[0]`, `(1..n)`, `x > y` — and a JSON literal is not valid in
  // any of those. The drop/echo head accepts an array literal through liquidVariable above,
  // which is scoped to exactly that position.
  liquidExpressionOrJsonLiteral<delim> = liquidJsonHashLiteral<delim> | liquidJsonArrayLiteral<delim> | liquidExpression<delim>
  positionalArgument<delim> = liquidExpressionOrJsonLiteral<delim> ~(space* ":")
  namedArgument<delim> = variableSegment space* ":" space* namedArgumentValue<delim>
  namedArgumentValue<delim> = hashPairValue<delim> | liquidExpressionOrJsonLiteral<delim>
  // hashPairValue handles nested key:value pairs within a named argument value, e.g.
  //   {% function res = 'path', filter: type: "string" %}
  // where `type: "string"` is the hashPairValue. Only fires when the value starts with
  // `identifier:` — otherwise namedArgumentValue falls through to liquidExpressionOrJsonLiteral.
  // Produces a NamedArgument node so linters can inspect nested argument pairs.
  hashPairValue<delim> = variableSegment space* ":" space* liquidExpression<delim>

  // TAG argument values, which accept a filter. FILTER argument values must NOT, so these
  // MIRROR positionalArgument/namedArgument/hashPairValue instead of widening them:
  // `arguments<delim>` is reached from `liquidFilter`, and widening the shared rules was
  // measured to break EVERY filter that takes an argument — `{{ 'a' | append: 'b' }}` threw
  // `Unexpected object: undefined`, and 9 of 9 baseline shapes changed.
  //
  // The filter here is DEAD CODE on the platform: `pos-cli deploy --dry-run` accepts it and
  // the runtime silently ignores it, because Ruby's `TagAttributes` scanner captures
  // `QuotedFragment`, which excludes `|`. Measured over 15 such positions against
  // `liquid_exec`, with 5 positive controls ({{ }}, assign, echo, session, return) where the
  // same probe DOES raise. It parses so the write gate cannot refuse a file that deploys, and
  // `FilterWithoutEffect` reports that the filter does nothing.
  //
  // `liquidFilter+`, not `*`: with `*` the filterless form still matches the first
  // alternative and wraps every argument in a needless LiquidVariable.
  tagPositionalArgument<delim> = tagArgumentValue<delim> ~(space* ":")
  tagNamedArgument<delim> = variableSegment space* ":" space* tagNamedArgumentValue<delim>
  tagNamedArgumentValue<delim> = tagHashPairValue<delim> | tagArgumentValue<delim>
  tagHashPairValue<delim> = variableSegment space* ":" space* tagArgumentValue<delim>
  tagArgumentValue<delim> =
    | tagArgumentValueWithFilters<delim>
    | liquidExpressionOrJsonLiteral<delim>
  tagArgumentValueWithFilters<delim> = liquidExpressionOrJsonLiteral<delim> liquidFilter<delim>+

  tagArguments = listOf<tagNamedArgument<delimTag>, argumentSeparatorOptionalComma>
  // The pre-filter spelling, kept for `resultFilterRenderArguments` — see its comment.
  filterlessTagArguments = listOf<namedArgument<delimTag>, argumentSeparatorOptionalComma>
  graphqlArguments = listOf<graphqlNamedArgument, argumentSeparatorOptionalComma>
  graphqlNamedArgument = variableSegment space* ":" space* graphqlNamedArgumentValue
  graphqlNamedArgumentValue = liquidExpression<delimTag>
  graphqlRenderArguments = (argumentSeparatorOptionalComma graphqlArguments) (space* ",")? space*
  filterArguments<delim> =
    | complexArguments<delim>
    | simpleArgument<delim>
  complexArguments<delim> = arguments<delim> (space* "," space* simpleArgument<delim>)?
  simpleArgument<delim> = liquidVariableLookup<delim>

  variableSegment = (letter | "_") (~endOfTagName identifierCharacter)*
  variableSegmentAsLookup = variableSegment
  identifier = variableSegment "?"?

  tagMarkup = anyExceptStar<delimTag>

  liquidTagName =
    letter (alnum | "_")*

  blockName =
    ( "form"
    // Base blocks
    | "capture"
    | "case"
    | "for"
    | "graphql"
    | "ifchanged"
    | "if"
    | "unless"
    | "tablerow"
    // platformos blocks
    | "background"
    | "cache"
    | "content_for"
    | "parse_json"
    | "transaction"
    // `try_rc` is an alias the platform registers against the same handler as `try`, and
    // it is a BLOCK, so its close tag must be recognised too. Measured, because the
    // delimiter does NOT follow the canonical name: `{% try_rc %}…{% endtry %}` is
    // rejected with "'endtry' is not a valid delimiter for try_rc tags. use endtry_rc",
    // while `{% try_rc %}…{% endtry_rc %}` renders. Listing it in the docset alone could
    // never fix this — `{% endtry_rc %}` would still be reported as an unknown tag, which
    // BLOCKS (TASK-56).
    //
    // `try_rc` BEFORE `try`: an ordered choice would match `try` and then choke on `_rc`.
    | "try_rc"
    | "try"
    ) endOfIdentifier

  delimTag = "-%}" | "%}"
  delimVO = "-}}" | "}}"
}

LiquidStatement <: Liquid {
  // Trailing ";"? and "#..." comment are consumed by Node and statementSep; the `;?`/`#` in
  // liquidStatementEnd make &delimTag succeed before them so expression rules terminate correctly.
  // tagMarkup uses liquidLineEnd (newline|end only) so inline-comment text is never truncated.
  Node := listOf<LiquidStatement, statementSep> ";"? ("#" (~newline any)*)? (space | newline)*

  // This is the big brains moment: we redefine space to exclude newlines.
  //
  // Which means that all our other Liquid rules can be reused
  // without modification(!)
  //
  // We don't need to maintain rules like this:
  // - liquidVariable<space>
  // - liquidExpression<space>
  // - variableLookup<space>
  // - ... long list of stuff that takes space as param
  // - liquidString<space>
  //
  // All we need is this little, VERY IMPORTANT, part right here that
  // make it so we can parse the same way in Liquid tags.
  //
  // I'm putting in this huge comment so that it's more obvious.
  space := " " | "\t"

  LiquidStatement =
    | liquidBlockComment
    | liquidRawTag
    | liquidTagClose
    | liquidTagOpen
    | liquidTag
    | liquidInlineComment

  liquidTagOpenRule<name, markup>
    := (name ~identifierCharacter) space* markup &liquidStatementEnd

  liquidTagRule<name, markup>
    := (name ~identifierCharacter) space* markup &liquidStatementEnd

  liquidTagClose
    := "end" (blockName ~identifierCharacter) space* tagMarkup &liquidStatementEnd

  liquidRawTagImpl<name>
    := (name ~identifierCharacter) space* tagMarkup newline
      anyExceptStar<liquidRawTagClose<name>>
      "end" name space* &liquidStatementEnd

  liquidRawTagClose<name>
    := "end" name space* &liquidStatementEnd

  liquidBlockComment :=
    commentBlockStart statementSep
      (listOf<liquidCommentBlockStatement, statementSep> statementSep)?
    commentBlockEnd

  liquidCommentBlockStatement =
    | liquidBlockComment
    | nonTerminalCommentLine

  commentBlockStart
    := ("comment" ~identifierCharacter) space* tagMarkup

  commentBlockEnd
    := ("endcomment" ~identifierCharacter) space* tagMarkup

  nonTerminalCommentLine
    = ~commentBlockEnd anyExceptPlus<newline>

  liquidInlineComment
    := "#" space? tagMarkup &liquidStatementEnd

  // tagMarkup uses liquidLineEnd (newline|end) so that raw # text is never cut off
  // (liquidInlineComment content, base-case tag markup, close-tag markup).
  liquidLineEnd = newline | end
  tagMarkup := anyExceptStar<liquidLineEnd>

  // Override string rules so that '#' inside string content is never mistaken for a
  // delimTag inline-comment marker. In LiquidStatement, delimTag includes `# ...` which
  // would otherwise cause the body rule to stop inside strings like '##label##'.
  // Strings in liquid blocks end at the matching quote or at a newline (no multi-line
  // strings). JSON literal strings keep their `\X` escape pairs here too.
  liquidSingleQuotedStringChar<delim> := ~("'" | newline | end) any
  liquidDoubleQuotedStringChar<delim> := ~("\"" | newline | end) any
  liquidJsonStringChar<delim> := ~("\"" | "\\" | newline | end) any

  // trailing whitespace, newline, + optional leading `;` and `# comment` before the next tag
  statementSep = space* ";"? space* ("#" (~newline any)*)? newline (space | newline)*

  // delimTag is used as &delim lookahead in expression rules; it must succeed before `;` and `#`
  liquidStatementEnd = ";"? space* ("#" (~newline any)*)? (newline | end)
  delimTag := liquidStatementEnd

  // Allow newlines inside hash/array literals within {% liquid %} blocks.
  // The base Liquid grammar restricts `space` to horizontal whitespace only, but hash/array
  // literals written across multiple lines need to match newlines between `{`/`[` and entries,
  // between entries (around commas), and between the last entry and the closing `}`/`]`.
  liquidJsonSep := (space | newline)* "," (space | newline)*
  liquidJsonHashLiteral<delim> := "{" (space | newline)* listOf<liquidJsonKeyValue<delim>, liquidJsonSep> (space | newline)* "}"
  liquidJsonArrayLiteral<delim> := "[" (space | newline)* listOf<liquidJsonValue<delim>, liquidJsonSep> (space | newline)* "]"

  // Inside {% liquid %} blocks, a tag's key:value argument list may span multiple lines.
  // Every argument-list tag whose separator is argumentSeparatorOptionalComma — function,
  // graphql, background, render, include, log, context, sign_in, transaction, cache, etc. —
  // inherits this automatically; the base Liquid grammar keeps these horizontal-only outside
  // {% liquid %}, so the standalone tag/block forms are unaffected (zero regression surface).
  //
  // A newline is only crossed AFTER a comma AND only when the next non-blank token is a
  // named argument (`name:`). This mirrors the Ruby runtime's continuation guard
  // (continuation_line? matches /\A[\w-]+\s*:/): a trailing comma followed by a new
  // directive (another tag, an assign, an echo, a bare/positional value such as
  // `log "second"`, …) does NOT look like `name:`, so the newline is not consumed, the list
  // ends, and the comma is treated as a stylistic trailing comma — the next line stays a
  // separate statement. This guard is essential for positional-accepting lists like log's,
  // where a following directive would otherwise be swallowed as a positional argument.
  //
  // Both alternatives must have the same arity (3: space, comma, group) for Ohm's uniform-arity
  // requirement and consistent visitor child indexing. The positive lookahead is written as
  // ~(~(...)) so it contributes arity 0, keeping the first alternative's group at arity 3.
  argumentSeparatorOptionalComma :=
      space* "," ((space | newline)* ~(~(variableSegment space* ":")))
    | space* ","? space*
}

LiquidDoc <: Helpers {
  Node := ImplicitDescription (LiquidDocNode | TextNode)*
  LiquidDocNode =
    | paramNode
    | exampleNode
    | descriptionNode
    | fallbackNode
  
  endOfDescription = strictSpace* openControl
  descriptionContent = anyExceptStar<endOfDescription>
  ImplicitDescription = descriptionContent
    
  // By default, space matches new lines as well. We override it here to make writing rules easier.
  strictSpace = " " | "\t"
  // We use this as an escape hatch to stop matching TextNode and try again when one of these characters is encountered
  openControl:=  strictSpace* ("@" | end)
  // The `{% doc %}` annotations, and THE ONE COPY of that vocabulary this repository keeps.
  //
  // Everything else about an annotation — which ones exist for an author, what each one means, the
  // worked example an editor shows, the types a `@param` may name — is published by the platform in
  // `liquid_doc.json` and read from the docset. This list cannot be, for exactly the reason
  // `NamedTags` cannot: a parse is synchronous and has no docset, and the boundary between one
  // annotation and the free-form text of the last one has to be decided while parsing.
  //
  // It once carried a fourth, `@prompt` — Shopify Magic's AI-provenance annotation, which arrived
  // with the fork. platformOS publishes no such annotation, nothing in the toolchain ever read one,
  // and the grammar was the only reason it existed. An `@prompt` an author already wrote still
  // parses and still survives a format: it falls through to `fallbackNode` and its lines come out
  // as text, which the printer emits verbatim. `stage-2-ast.spec.ts` and the `liquid-doc-prompt`
  // formatter fixture pin both halves, because the printer REGENERATES source and a construct the
  // AST stops carrying is deleted from the author's file silently.
  //
  // Nothing downstream may read this list as the vocabulary — `guards/liquid-doc-vocabulary.spec.ts`
  // names this file as the single exemption and fails the build on a second copy anywhere else.
  supportedTags = "@example" | "@description" | "@param"


  paramNode = "@param" strictSpace* paramType? strictSpace* (optionalParamName | paramName) (strictSpace* "-")? strictSpace* paramDescription
  paramType = "{" strictSpace* paramTypeContent strictSpace* "}"
  paramTypeContent = anyExceptStar<("}"| strictSpace)>

  paramName = textValue
  optionalParamName = "[" strictSpace* textValue strictSpace* "]"
  textValue = identifierCharacter+

  paramDescription = (~"]" anyExceptStar<endOfParam>)
  endOfParam = strictSpace* (newline | end)
  
  exampleNode = "@example" space* multilineTextContent
  descriptionNode = "@description" space* multilineTextContent

  // We want multilineTextContent to be free-form, so instead of terminating the match at "@" we explicitly look for a suppported tag
  // This means that malformed tags will be considered part of the multilineTextContent
  multilineTextContent = anyExceptStar<endOfMultilineText>
  endOfMultilineText =  strictSpace* (supportedTags | end)

  fallbackNode = "@" anyExceptStar<endOfParam>
}

LiquidHTML <: Liquid {
  Node := yamlFrontmatter? (HtmlNode | liquidNode | TextNode)*
  openControl += "<"

  yamlFrontmatter =
    "---" newline anyExceptStar<"---"> "---" newline

  // PERF: same idea as `liquidNode`, smaller payoff. Guards the doctype /
  // comment / processing-instruction / raw-tag / void-element scan — including the
  // `caseInsensitive<1>` applications for `voidElementName`, which are also
  // parameterized and so also never memoize — behind one character. Arity 0, so
  // the CST shape is unchanged.
  HtmlNode =
    ~(~"<") (HtmlDoctype
      | HtmlComment
      | HtmlProcessingInstruction
      | HtmlRawTag
      | HtmlVoidElement
      | HtmlSelfClosingElement
      | HtmlTagClose
      | HtmlTagOpen)

  // https://html.spec.whatwg.org/multipage/syntax.html#the-doctype
  HtmlDoctype =
    #("<!" caseInsensitive<"doctype"> space+ caseInsensitive<"html">) legacyDoctypeString? ">"
  legacyDoctypeString
    = anyExceptPlus<">">

  HtmlComment = "<!--" #(anyExceptStar<"-->"> "-->")

  // Handles XML declarations (<?xml ...?>) and other processing instructions (<?...?>)
  HtmlProcessingInstruction = "<?" #(anyExceptStar<"?>"> "?>")

  // These are black holes, we'll ignore what's in them
  HtmlRawTag =
    | HtmlRawTagImpl<"script">
    | HtmlRawTagImpl<"style">
    | HtmlRawTagImpl<"svg">

  HtmlRawTagImpl<name> =
    TagStart<name>
      (HtmlRawTagImpl<name> | AnyExceptPlus<(TagStart<name> | TagEnd<name>)>)*
    TagEnd<name>
  TagStart<name> = "<" name AttrList ">"
  TagEnd<name> = "</" name ">"

  HtmlVoidElement =
    #("<" voidElementName &(space | "/" | ">")) AttrList "/"? ">"

  HtmlSelfClosingElement =
    #("<" tagName) AttrList "/>"

  HtmlTagOpen =
    #("<" tagName) AttrList ">"

  HtmlTagClose =
    #("</" tagName) ">"

  tagName = leadingTagNamePart trailingTagNamePart*

  // The difference here is that the first text part must start
  // with a letter, but trailing text parts don't have that
  // requirement
  leadingTagNamePart =
    | liquidDrop
    | leadingTagNameTextNode

  trailingTagNamePart =
    | liquidDrop
    | trailingTagNameTextNode

  leadingTagNameTextNode = letter (alnum | "-" | ":")*
  trailingTagNameTextNode = (alnum | "-" | ":")+

  AttrList = Attr*

  Attr =
    AttrSingleQuoted | AttrDoubleQuoted | AttrUnquoted | liquidNode | attrEmpty

  attrEmpty = attrName

  AttrUnquoted = attrName "=" attrUnquotedValue
  AttrSingleQuoted = attrName "=" singleQuote #(attrSingleQuotedValue singleQuote)
  AttrDoubleQuoted = attrName "=" doubleQuote #(attrDoubleQuotedValue doubleQuote)

  attrName = (liquidDrop | attrNameTextNode)+

  // https://html.spec.whatwg.org/#attributes-2
  attrNameTextNode = anyExceptPlus<(space | quotes | "=" | ">" | "/>" | "{{" | "{%" | controls | noncharacters)>
  attrUnquotedValue = (liquidDrop | attrUnquotedTextNode)*
  attrSingleQuotedValue = (liquidNode | attrSingleQuotedTextNode)*
  attrDoubleQuotedValue = (liquidNode | attrDoubleQuotedTextNode)*

  attrUnquotedTextNode = anyExceptPlus<(space | quotes | "=" | "<" | ">" | "`" | "{{" | "{%")>
  attrSingleQuotedTextNode = anyExceptPlus<(singleQuote | "{{" | "{%")>
  attrDoubleQuotedTextNode = anyExceptPlus<(doubleQuote | "{{" | "{%")>

  quotes = singleQuote | doubleQuote

  // https://www.w3.org/TR/2011/WD-html-markup-20110113/syntax.html#void-element
  voidElementName =
    ( caseInsensitive<"area">
    | caseInsensitive<"base">
    | caseInsensitive<"br">
    | caseInsensitive<"col">
    | caseInsensitive<"command">
    | caseInsensitive<"embed">
    | caseInsensitive<"hr">
    | caseInsensitive<"img">
    | caseInsensitive<"input">
    | caseInsensitive<"keygen">
    | caseInsensitive<"link">
    | caseInsensitive<"meta">
    | caseInsensitive<"param">
    | caseInsensitive<"source">
    | caseInsensitive<"track">
    | caseInsensitive<"wbr">
    ) ~identifierCharacter
}

StrictLiquid <: Liquid {
  liquidTag := liquidTagStrict
  liquidTagOpen := liquidTagOpenStrict
}

StrictLiquidStatement <: LiquidStatement {
  liquidTag := liquidTagStrict
  liquidTagOpen := liquidTagOpenStrict
}

StrictLiquidHTML <: LiquidHTML {
  liquidTag := liquidTagStrict
  liquidTagOpen := liquidTagOpenStrict
}

WithPlaceholderLiquid <: Liquid {
  liquidFilter<delim> := space* "|" space* identifier (space* ":" space* filterArguments<delim> (space* ",")?)?
  liquidTagRenderMarkup :=
    liquidString<delimTag> renderVariableExpression? renderAliasExpression? completionModeRenderArguments
  liquidTagIncludeMarkup :=
    partialExpression renderVariableExpression? renderAliasExpression? completionModeRenderArguments
  liquidTagName := (letter | "█") (alnum | "_")*
  variableSegment := (letter | "_" | "█") (identifierCharacter | "█")*
  dotLookupName := (alnum | "_" | "█") (~endOfTagName (identifierCharacter | "█"))* "?"?
  liquidDoc :=
    liquidDocStart
      liquidDocBody
    liquidDocEnd?
}

WithPlaceholderLiquidStatement <: LiquidStatement {
  liquidFilter<delim> := space* "|" space* identifier (space* ":" space* filterArguments<delim> (space* ",")?)?
  liquidTagRenderMarkup :=
    liquidString<delimTag> renderVariableExpression? renderAliasExpression? completionModeRenderArguments
  liquidTagIncludeMarkup :=
    partialExpression renderVariableExpression? renderAliasExpression? completionModeRenderArguments
  liquidTagName := (letter | "█") (alnum | "_")*
  variableSegment := (letter | "_" | "█") (identifierCharacter | "█")*
  dotLookupName := (alnum | "_" | "█") (~endOfTagName (identifierCharacter | "█"))* "?"?
  liquidDoc :=
    liquidDocStart
      liquidDocBody
    liquidDocEnd?
}

WithPlaceholderLiquidHTML <: LiquidHTML {
  liquidFilter<delim> := space* "|" space* identifier (space* ":" space* filterArguments<delim> (space* ",")?)?
  liquidTagRenderMarkup :=
    liquidString<delimTag> renderVariableExpression? renderAliasExpression? completionModeRenderArguments
  liquidTagIncludeMarkup :=
    partialExpression renderVariableExpression? renderAliasExpression? completionModeRenderArguments
  liquidTagName := (letter | "█") (alnum | "_")*
  variableSegment := (letter | "_" | "█") (identifierCharacter | "█")*
  dotLookupName := (alnum | "_" | "█") (~endOfTagName (identifierCharacter | "█"))* "?"?
  leadingTagNameTextNode := (letter | "█") (alnum | "-" | ":" | "█")*
  trailingTagNameTextNode := (alnum | "-" | ":" | "█")+
  liquidDoc :=
    liquidDocStart
      liquidDocBody
    liquidDocEnd?
}
