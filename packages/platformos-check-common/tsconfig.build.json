{
  "extends": "./tsconfig.json",
  // `*-oracle.ts` names measured test data — read only by the spec that consumes it. There is
  // none right now; the pattern stays so the next one is excluded by existing, for the same
  // reason `*.spec.ts` is: shipping fixtures in the published package costs every consumer
  // bytes for something no consumer can call.
  "exclude": ["**/*.spec.ts", "**/*-oracle.ts"],
  "references": [
    { "path": "../liquid-html-parser/tsconfig.build.json" },
    { "path": "../platformos-common/tsconfig.build.json" }
  ]
}
