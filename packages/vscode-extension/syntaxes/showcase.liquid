{% graphql people, limit: 10 %}
  query people($limit: Int) {
    records(per_page: $limit, filter: { table: { value: "person" } }) {
      results {
        id
        properties
      }
    }
  }
{% endgraphql %}

<ul>
  {% for person in people.records.results %}
    <li>
      {% assign avatar = person.properties.avatar %}
      <img
        alt="{{ person.properties.name }}"
        src="{{
          avatar
          | image_url:
            width: 500,
            height: 500
        }}"
        height="500"
        width="500"
        loading="lazy"
      >
    </li>
  {% endfor %}
</ul>

The body of a graphql block is a GraphQL document, and a parse_json body is JSON.
{% parse_json settings %}
  {
    "locale": "{{ context.language }}",
    "page": {{ page.slug | json }}
  }
{% endparse_json %}

<script>
  // The drop is highlighted because liquid will render inside the comment.
  // As such, it isn't a "real" comment w.r.t. liquid.
  // comment {{ page.title }}
  function main(arg1) {
    if (condition) {
      {% if condition %}
        const foo = {{ variable | filter: arg1 | json }}
      {% endif %}
    }
  }
</script>

<style>
  :root {
    {% if context.constants.FONT_FAMILY %}
      --font-family-secondary: {{ context.constants.FONT_FAMILY }};
    {% endif %}
  }

  #id.class {
    background-color: rgba(100, 100, 100);
  }
</style>

{% raw %}
  this should be free form
  {% comment %} does not need to close
  {{ does not get highlighted }}
{% endraw %}

This is content that follows the raw tag.
The with, as, for and as keywords are highlighted as keywords.
{% render 'person' with foo as bar %}
{% render 'variant' for elements as element %}
{% include 'legacy/partial', named: my_variable %}

You can write tags on multiple lines and the highlighting will follow.
{%
  render 'name', named: my_variable,
  other:
    'oranges'
%}

Works pretty well in the liquid tag too.
{% liquid
  render 'name', named: my_variable, other: 'oranges'
  render 'name' with foo as bar
  render 'name' for elements as element
%}

Control flow tags are keywords and highlight the need to be closed
{% if condition %}{% endif %}
{% case fruit %}
  {% when 'apple' %}
  {% else %}
{% endcase %}

platformOS block tags are keywords too, and fold.
{% try %}
  {% transaction %}
    {% function person = 'modules/core/commands/person/create', name: params.name %}
    {% if person.errors %}
      {% rollback %}
    {% endif %}
  {% endtransaction %}
{% catch error %}
  {% log error, type: 'error' %}
{% endtry %}

{% cache 'people-list', expire: 60 %}
  {% content_for 'head' %}
    <meta name="robots" content="noindex">
  {% endcontent_for %}
{% endcache %}

{% background notify = 'modules/core/commands/notify', id: person.id %}

Single line tags are entities in a different color
{% assign x = 1 %}
{% echo x %}
{% print x %}
{% cycle 'a', 'b', 'c' %}
{% return { "status": 200 } %}

The highlighting works in liquid tags too!
{% liquid
  if condition
    assign x = 1
  elsif condition
    echo x | plus: 1
  else
    cycle 'a', 'b', 'c'
  endif
%}
